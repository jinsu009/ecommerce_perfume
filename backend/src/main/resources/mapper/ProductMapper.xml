<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org/DTD Mapper 3.0/EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ecommerce.perfume.repository.ProductMapper">

    <select id="findAllPerfumes" resultType="com.ecommerce.perfume.domain.entity.PerfumeProduct">
        SELECT
            PF_PRODUCT_CODE,
            PF_PRODUCT_NAME,
            PF_PRODUCT_BRAND,
            PF_PRODUCT_COMMENT,
            PF_PRODUCT_PRICE
        FROM 
            PERFUME_PRODUCT
    </select>

</mapper>