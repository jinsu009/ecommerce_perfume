<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org/DTD Mapper 3.0/EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ecommerce.perfume.repository.UserMapper">

    <select id="findUserById" resultType="com.ecommerce.perfume.domain.entity.User">
        SELECT
            USER_ID,
            USER_NAME,
            USER_EMAIL
        FROM 
            USERS
        WHERE
            USER_ID = #{userId}
    </select>   

</mapper>
